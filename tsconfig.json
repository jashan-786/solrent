{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true
  },
  "include": ["prisma.config.ts", ".env"],
  "exclude": ["node_modules", "apps", "packages"]
}
