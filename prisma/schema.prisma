generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id @default(cuid())
  name               String
  email              String         @unique
  phone              String?
  avatarUrl          String?
  walletAddress      String?        @unique
  role               UserRole
  preferredCoin      String?        @default("USDC")
  landlordBuildingId String?
  landlordId         String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  landlordBuildings  Building[]     @relation("LandlordBuildings")
  usedInviteCode     InviteCode?    @relation("UserUsedInvite")
  tenantLeases       Lease[]        @relation("TenantLeases")
  receivedMessages   Message[]      @relation("ReceivedMessages")
  sentMessages       Message[]      @relation("SentMessages")
  notifications      Notification[]
  maintenanceReqs    MaintenanceRequest[] @relation("TenantMaintenance")
}

model Building {
  id          String       @id @default(cuid())
  name        String
  address     String
  city        String
  province    String
  postalCode  String
  landlordId  String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  landlord    User         @relation("LandlordBuildings", fields: [landlordId], references: [id])
  inviteCodes InviteCode[]
  units       Unit[]
  leases      Lease[]
  payments    Payment[]
  maintenance MaintenanceRequest[]
}

model Unit {
  id          String       @id @default(cuid())
  buildingId  String
  unitNumber  String
  bedrooms    Int
  bathrooms   Int
  squareFeet  Int?
  rentAmount  Float
  occupied    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  inviteCodes InviteCode[]
  leases      Lease[]
  building    Building     @relation(fields: [buildingId], references: [id])
  maintenance MaintenanceRequest[]
}

model Lease {
  id                String      @id @default(cuid())
  tenantId          String
  unitId            String
  buildingId        String
  monthlyRent       Float
  depositAmount     Float?
  stablecoin        String      @default("USDC")
  startDate         DateTime
  endDate           DateTime
  status            LeaseStatus
  autoPayEnabled    Boolean     @default(false)
  recurringApproved Boolean     @default(false)
  leaseDocumentUrl  String?
  leaseNftMint      String?
  onChainId         BigInt?
  onChainAddress    String?
  transactionHash   String?
  nextDueTimestamp  BigInt?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  tenant            User        @relation("TenantLeases", fields: [tenantId], references: [id])
  unit              Unit        @relation(fields: [unitId], references: [id])
  payments          Payment[]
  building          Building    @relation(fields: [buildingId], references: [id])
}

model Payment {
  id                String        @id @default(cuid())
  leaseId           String
  buildingId        String
  amount            Float
  stablecoin        String
  dueDate           DateTime
  paidAt            DateTime?
  status            PaymentStatus
  transactionHash   String?
  nftReceiptMint    String?
  failureReason     String?
  recurringApproved Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  lease             Lease         @relation(fields: [leaseId], references: [id])
  building          Building      @relation(fields: [buildingId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
}

model InviteCode {
  id         String   @id @default(cuid())
  code       String   @unique
  buildingId String
  unitId     String?
  isUsed     Boolean  @default(false)
  usedById   String?  @unique
  createdAt  DateTime @default(now())
  building   Building @relation(fields: [buildingId], references: [id])
  unit       Unit?    @relation(fields: [unitId], references: [id])
  usedBy     User?    @relation("UserUsedInvite", fields: [usedById], references: [id])
}

model MaintenanceRequest {
  id          String   @id @default(cuid())
  tenantId    String
  unitId      String
  buildingId  String
  title       String
  description String
  priority    String   @default("LOW")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      User     @relation("TenantMaintenance", fields: [tenantId], references: [id])
  unit        Unit     @relation(fields: [unitId], references: [id])
  building    Building @relation(fields: [buildingId], references: [id])
}

enum UserRole {
  LANDLORD
  TENANT
}

enum LeaseStatus {
  ACTIVE
  PENDING
  TERMINATION_REQUESTED
  EXPIRED
  TERMINATED
}

enum PaymentStatus {
  UPCOMING
  COMPLETED
  FAILED
  OVERDUE
}

enum NotificationType {
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  RENT_DUE
  LEASE_CREATED
  MESSAGE
}
